---
import { CAL_LINK } from '../lib/booking';

interface Props {
  hideDetails?: boolean;
}

const { hideDetails = false } = Astro.props;
---
<!-- Keyboard users can jump over the calendar, and scroll it once focused (WCAG 2.1.1) -->
<a class="cal-embed__skip skip-link" href="#cal-embed-end">Saltar la agenda</a>
<div
  class="cal-embed"
  id="my-cal-inline-30min"
  role="region"
  aria-label="Agenda de llamadas con Uxuaria"
  tabindex="0"
  data-cal-link={CAL_LINK}
  data-hide-details={String(hideDetails)}
></div>
<span id="cal-embed-end" tabindex="-1"></span>
<script is:inline>
  (function () {
    const el = document.getElementById('my-cal-inline-30min');
    if (!el) return;

    function start() {
      // /booking.js loads Cal.com once and tracks the booking (generate_lead)
      const cal = window.uxuariaBooking.calNamespace("30min", "cal_embed");
      cal("inline", {
        elementOrSelector: "#my-cal-inline-30min",
        config: { layout: "month_view", useSlotsViewOnSmallScreen: "true" },
        calLink: el.dataset.calLink,
      });
      cal("ui", { hideEventTypeDetails: el.dataset.hideDetails === "true", layout: "month_view" });

      // Cal.com titles its iframe "Book a call"; give it a Spanish name (WCAG 4.1.2, 3.1.2).
      // Cal.com may already be loaded (popup), so the iframe can exist right after "inline".
      const nameFrame = () => {
        const frame = el.querySelector('iframe');
        if (!frame) return false;
        frame.title = 'Agenda una llamada con Uxuaria';
        return true;
      };
      if (!nameFrame()) {
        const watcher = new MutationObserver(() => { if (nameFrame()) watcher.disconnect(); });
        watcher.observe(el, { childList: true, subtree: true });
      }
    }

    // Loads when the block gets close, so it does not slow down the first paint
    const observer = new IntersectionObserver((entries) => {
      if (!entries[0].isIntersecting) return;
      observer.disconnect();
      // window.uxuariaBooking comes from /booking.js, loaded in <head> (BaseLayout)
      if (window.uxuariaBooking) start();
    }, { rootMargin: '400px 0px' });
    observer.observe(el);
  })();
</script>
