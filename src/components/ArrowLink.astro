---
interface Props {
  label: string;
  href?: string;
  align?: 'start' | 'end';
}

const { label, href, align = 'end' } = Astro.props;
// No href renders a label: pending destination (spec 11-home) or inside a linked card
const Tag = href ? 'a' : 'span';
---
<Tag href={href} class:list={['arrow-link', `arrow-link--${align}`]}>
  {label}
  <img src="/images/home/arrow-up-right.svg" width="24" height="24" alt="" />
</Tag>
