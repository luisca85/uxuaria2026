---
import { SERVICES } from '../lib/services';
---
<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <span class="site-footer__wordmark">uxuaria</span>
      <p class="site-footer__tagline">Agencia de diseño UX/UI para startups que crecen en LATAM.</p>
      <a href="https://www.linkedin.com/company/uxuaria/" target="_blank" rel="noopener"
         class="site-footer__social" aria-label="LinkedIn de Uxuaria">
        <img src="/images/home/icon-social.svg" width="20" height="20" alt="" />
      </a>
    </div>
    <div class="site-footer__links">
      {/* Items without a link have no destination yet: spec 11-home, "Destinos" */}
      <div class="site-footer__col">
        <a href="/servicios/" class="site-footer__col-title">Servicios</a>
        {SERVICES.map((service) => <a href={service.href} class="site-footer__item">{service.name}</a>)}
      </div>
      <div class="site-footer__col">
        <p class="site-footer__col-title">Navegación</p>
        <a href="/sobre-nosotros/" class="site-footer__item">Sobre nosotros</a>
        <a href="/portafolio" class="site-footer__item">Proyectos</a>
        <a href="/blog" class="site-footer__item">Blog</a>
        <a href="/mutisux/" class="site-footer__item">Mutis UX</a>
        <a href="https://sakura64.uxuaria.com/" target="_blank" rel="noopener" class="site-footer__item">SAKURA 64</a>
        <a href="/contacto/" class="site-footer__item">Contáctame</a>
      </div>
      <div class="site-footer__col">
        <p class="site-footer__col-title">Contacto</p>
        <a href="mailto:info@uxuaria.com" class="site-footer__item">info@uxuaria.com</a>
        {/* English pending (spec 11-home): <span class="site-footer__item">🌐 Español / English</span> */}
      </div>
    </div>
  </div>
  <p class="site-footer__bottom">
    © 2020 – {new Date().getFullYear()} Uxuaria · Luis Carlos Romero León
    {/* cookies.js opens the notice again from data-cookie-settings */}
    · <a href="/privacidad/" class="site-footer__legal">Política de privacidad</a>
    · <button type="button" class="site-footer__legal" data-cookie-settings>Preferencias de cookies</button>
  </p>
</footer>
