---
import { SERVICES } from '../lib/services';
import { BOOKING_URL } from '../lib/booking';

const links = [
  { href: '/portafolio', label: 'Proyectos' },
  { href: '/blog', label: 'Blog' },
  { href: '/contacto/', label: 'Contacto' },
];

const path = Astro.url.pathname.replace(/\/$/, '');
const currentAttr = (href: string) => {
  const section = href.replace(/\/$/, '');
  return path === section || path.startsWith(`${section}/`) ? 'page' : undefined;
};
// The Servicios toggle reads as current on any service page
const inServices = SERVICES.some((service) => currentAttr(service.href));
---
<header class="site-header" id="navbar">
  <div class="site-header__inner">
    <a href="/" class="site-header__logo" aria-label="Uxuaria, inicio">uxuaria</a>
    <div class="site-header__actions">
      <nav class="site-header__nav" aria-label="Navegación principal">
        {/* Without JavaScript the menu opens on hover and on keyboard focus */}
        <div class="site-header__services" data-services>
          <button type="button" class:list={['site-header__item', 'site-header__services-toggle', { 'is-current': inServices }]}
                  aria-expanded="false" aria-controls="servicesMenu">
            Servicios
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
          </button>
          <div class="site-mega" id="servicesMenu">
            <div class="site-mega__inner">
              <a href="/servicios/" class="site-mega__eyebrow" data-track="nav_servicios_todos">Ver todos los servicios</a>
              <ul class="site-mega__list">
                {SERVICES.map((service) => (
                  <li>
                    <a href={service.href} class="site-mega__link" aria-current={currentAttr(service.href)} data-track={`nav_servicios_${service.id}`}>
                      <span class="site-mega__name">{service.name}</span>
                      <span class="site-mega__summary">{service.summary}</span>
                      <img class="site-mega__arrow" src="/images/home/arrow-up-right.svg" width="24" height="24" alt="" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
        <a href="/portafolio" aria-current={currentAttr('/portafolio')} class="site-header__item site-header__item--padded">Proyectos</a>
        <a href="/blog" aria-current={currentAttr('/blog')} class="site-header__item site-header__item--padded">Blog</a>
        <a href="/contacto/" aria-current={currentAttr('/contacto/')} class="site-header__item">Contacto</a>
      </nav>
      {/* Booking page, approved by Luis (2026-11-11) */}
      <a href={BOOKING_URL} target="_blank" rel="noopener" class="pill-button" data-track="cta_nav_empecemos">Empecemos ahora</a>
      <span class="site-header__item site-header__item--active">ES</span>
      {/* English pending (spec 11-home): <span class="site-header__item site-header__item--inactive">EN</span> */}
    </div>
    <div class="site-header__compact">
      <span class="site-header__item site-header__item--active">ES</span>
      {/* English pending (spec 11-home): <span class="site-header__item site-header__item--inactive">EN</span> */}
      <button class="site-header__hamburger" id="hamburger"
              aria-label="Abrir menú" aria-expanded="false" aria-controls="mobileMenu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <div class="site-header__menu" id="mobileMenu" aria-hidden="true">
    <a href="/servicios/" class="site-header__menu-label">Servicios</a>
    {SERVICES.map((service) => (
      <a href={service.href} aria-current={currentAttr(service.href)} class="site-header__item site-header__item--sub">{service.name}</a>
    ))}
    {links.map((link) => <a href={link.href} aria-current={currentAttr(link.href)} class="site-header__item">{link.label}</a>)}
  </div>
</header>

<script is:inline>
  // Servicios menu: opens on click, on hover and with the keyboard; Escape or leaving closes it
  (function () {
    const wrap = document.querySelector('[data-services]');
    if (!wrap) return;
    const toggle = wrap.querySelector('.site-header__services-toggle');
    const hover = matchMedia('(hover: hover)');
    let timer, pinned = false;
    wrap.classList.add('is-enhanced');

    function set(open) {
      clearTimeout(timer);
      if (!open) pinned = false;
      wrap.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    }

    // A click pins the menu open, even if hovering already opened it; a second click closes it
    toggle.addEventListener('click', () => {
      if (pinned) { set(false); return; }
      set(true);
      pinned = true;
    });
    wrap.addEventListener('mouseenter', () => { if (hover.matches) set(true); });
    wrap.addEventListener('mouseleave', () => { if (hover.matches && !pinned) timer = setTimeout(() => set(false), 150); });
    wrap.addEventListener('focusout', (e) => { if (!wrap.contains(e.relatedTarget)) set(false); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && wrap.classList.contains('is-open')) { set(false); toggle.focus(); }
    });
    document.addEventListener('click', (e) => { if (!wrap.contains(e.target)) set(false); });
  })();
</script>
