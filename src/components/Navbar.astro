---
const links = [
  { href: '/servicios/', label: 'Servicios' },
  { href: '/ai-mvp-rescue', label: 'AI MVP Rescue' },
  { href: '/blog', label: 'Blog' },
  { href: '/contacto/', label: 'Contacto' },
];
---
<header class="navbar" id="navbar">
  <div class="container navbar__inner">
    <a href="/" class="navbar__logo" aria-label="Uxuaria — inicio">
      <span class="logo-text">uxuaria</span>
    </a>
    <nav class="navbar__nav" aria-label="Navegación principal">
      {links.map((link) => <a href={link.href} class="nav-link">{link.label}</a>)}
    </nav>
    <a href="/contacto/" class="btn btn--primary navbar__cta">Contáctame</a>
    <button class="navbar__hamburger" id="hamburger"
            aria-label="Abrir menú" aria-expanded="false" aria-controls="mobileMenu">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="mobile-menu" id="mobileMenu" aria-hidden="true">
    {links.map((link) => <a href={link.href} class="nav-link">{link.label}</a>)}
    <a href="/contacto/" class="btn btn--primary">Contáctame</a>
  </div>
</header>
