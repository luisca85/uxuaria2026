---
import ArrowLink from './ArrowLink.astro';
import { cardDate, type Post } from '../lib/blog';

interface Props {
  post: Post;
  variant?: 'grid' | 'featured' | 'related';
}

const { post, variant = 'grid' } = Astro.props;
const { title, excerpt, description, category, pubDate, cover, cardImage } = post.data;
const img = cardImage ?? cover;
const date = cardDate(pubDate);
const Heading = variant === 'related' ? 'h3' : 'h2';
---
<a href={`/blog/${post.id}`} class:list={['post-card', `post-card--${variant}`]}>
  <div class="post-card__image">
    {/* The card's heading already names the link; an alt with the same title is read twice */}
    <img src={img.src} width={img.width} height={img.height} alt="" loading="lazy" />
  </div>
  <div class="post-card__content">
    {variant === 'featured' && (
      <>
        <span class="badge">Artículo destacado</span>
        <p class="post-card__date">{category} · {date}</p>
      </>
    )}
    {variant === 'grid' && (
      <>
        <span class="badge post-card__category">{category}</span>
        <p class="post-card__date">{date}</p>
      </>
    )}
    {variant === 'related' && (
      <div class="post-card__meta">
        <span class="badge">{category}</span>
        <p class="post-card__date">{date}</p>
      </div>
    )}
    <Heading class="post-card__title">{title}</Heading>
    <p class="post-card__excerpt">{excerpt ?? description}</p>
    <ArrowLink label={variant === 'featured' ? 'Leer artículo completo' : 'Leer más'} align="start" />
  </div>
</a>
