---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getPosts, longDate, isoDate, type Post } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

interface Props {
  post: Post;
  posts: Post[];
}

const { post, posts } = Astro.props;
const { title, seoTitle, description, category, pubDate, updatedDate, readingTime, cover, ogImage } = post.data;
const { Content } = await render(post);
const related = posts.filter((p) => p.id !== post.id).slice(0, 2);
const url = new URL(`/blog/${post.id}`, Astro.site).href;
const image = new URL(ogImage ?? cover.src, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: isoDate(pubDate),
  dateModified: isoDate(updatedDate ?? pubDate),
  image,
  author: { '@type': 'Person', '@id': 'https://uxuaria.com/#luis', name: 'Luis Carlos Romero León' },
  publisher: { '@type': 'Organization', name: 'Uxuaria', url: 'https://uxuaria.com' },
  url,
  inLanguage: 'es-AR',
};
---
<BaseLayout
  title={seoTitle ?? `${title} | Uxuaria Blog`}
  description={description}
  ogTitle={`${title} | Uxuaria`}
  ogImage={ogImage ?? cover.src}
  ogType="article"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={isoDate(pubDate)} />
    <meta property="article:author" content="https://uxuaria.com/#luis" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="article-header">
    <div class="article-column">
      <nav class="breadcrumb" aria-label="Ruta de navegación">
        <a href="/" class="breadcrumb__item">Home</a>
        <span class="breadcrumb__sep">›</span>
        <a href="/blog" class="breadcrumb__item">Blog</a>
        <span class="breadcrumb__sep">›</span>
        <span class="breadcrumb__item breadcrumb__item--current">{title}</span>
      </nav>
      <div class="article-header__meta">
        <span class="blog-card__meta">{category}</span>
      </div>
      <h1 class="article-header__title">{title}</h1>
      <p class="article-header__date">{longDate(pubDate)} &nbsp;·&nbsp; {readingTime} min de lectura</p>
    </div>
  </div>

  <div class="article-cover">
    <div class="article-column">
      <div class="article-cover__img">
        <img src={cover.src} width={cover.width} height={cover.height} alt={cover.alt} fetchpriority="high" />
      </div>
    </div>
  </div>

  <div class="article-column">
    <article class="article-body">
      <Content />
    </article>
  </div>

  {related.length > 0 && (
    <section class="related-articles" aria-label="Más artículos">
      <div class="related-articles__header">
        <p class="section-eyebrow">Más artículos</p>
      </div>
      <div class="related-articles__track">
        {related.map((p) => <BlogCard post={p} />)}
      </div>
    </section>
  )}

  <section class="article-cta">
    <div class="container">
      <p class="article-cta__badge">
        <span class="badge-dot badge-dot--light"></span>
        Asesorías disponibles
      </p>
      <h2 class="article-cta__title">¿Querés aplicar todo esto<br>en tu proyecto?</h2>
      <p class="article-cta__desc">Agendá una charla honesta de 30 minutos sin costo. Sin fórmulas mágicas — encontramos juntos dónde está la oportunidad real.</p>
      <a href="mailto:info@uxuaria.com?subject=Quiero%20trabajar%20con%20Uxuaria&body=Hola%20Luis%2C%0A%0AMe%20interesa%20conocer%20m%C3%A1s%20sobre%20tus%20servicios.%0A%0A" class="btn btn--white btn--lg">
        Escribime a info@uxuaria.com
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>
