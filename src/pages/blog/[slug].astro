---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getPosts, longDate, isoDate, type Post } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

interface Props {
  post: Post;
  posts: Post[];
}

const { post, posts } = Astro.props;
const { title, seoTitle, description, category, pubDate, updatedDate, readingTime, cover, ogImage } = post.data;
const { Content } = await render(post);
const related = posts.filter((p) => p.id !== post.id).slice(0, 2);
const CALENDLY_URL = 'https://calendly.com/luisca85/charla-introductoria-clone';
const url = new URL(`/blog/${post.id}`, Astro.site).href;
const image = new URL(ogImage ?? cover.src, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: isoDate(pubDate),
  dateModified: isoDate(updatedDate ?? pubDate),
  image,
  author: { '@type': 'Person', '@id': 'https://uxuaria.com/#luis', name: 'Luis Carlos Romero León' },
  publisher: { '@type': 'Organization', name: 'Uxuaria', url: 'https://uxuaria.com' },
  url,
  inLanguage: 'es-AR',
};
---
<BaseLayout
  title={seoTitle ?? `${title} | Uxuaria Blog`}
  description={description}
  ogTitle={`${title} | Uxuaria`}
  ogImage={ogImage ?? cover.src}
  ogType="article"
  legacyStyles={false}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/blog.css?v=20261102" />
    <meta property="article:published_time" content={isoDate(pubDate)} />
    <meta property="article:author" content="https://uxuaria.com/#luis" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="blog-page">
    <header class="post-header blog-container">
      <nav class="blog-breadcrumb" aria-label="Ruta de navegación">
        <a href="/" class="blog-breadcrumb__item">HOME</a>
        <span class="blog-breadcrumb__separator" aria-hidden="true">›</span>
        <a href="/blog" class="blog-breadcrumb__item">BLOG</a>
        <span class="blog-breadcrumb__separator" aria-hidden="true">›</span>
        <span class="blog-breadcrumb__current" aria-current="page">{title}</span>
      </nav>
      <div class="post-header__heading">
        <span class="badge">{category}</span>
        <h1 class="post-header__title">{title}</h1>
        <p class="post-header__date">{longDate(pubDate)} · {readingTime} min de lectura</p>
      </div>
      <div class="post-header__cover">
        <img src={cover.src} width={cover.width} height={cover.height} alt={cover.alt} fetchpriority="high" />
      </div>
    </header>

    <article class="post-body">
      <Content />
    </article>

    {/* Biography is literal from Figma until approved: spec 12-blog-redesign, A CONFIRMAR #6 */}
    <aside class="post-author" aria-label="Sobre el autor">
      <span class="badge">Sobre el autor</span>
      <p class="post-author__name">Luis Carlos Romero León</p>
      <p class="post-author__bio">Consultor UX detrás de Uxuaria, con base en Buenos Aires, Argentina. Lleva más de 15 años trabajando en productos digitales con startups y empresas en crecimiento de Argentina y LATAM. Se especializa en productos financieros digitales y en evaluar experiencias construidas con IA.</p>
    </aside>

    {related.length > 0 && (
      <section class="post-related" aria-label="Más artículos">
        <div class="blog-container">
          <span class="badge">Más artículos</span>
          <div class="post-related__grid">
            {related.map((p) => <BlogCard post={p} variant="related" />)}
          </div>
        </div>
      </section>
    )}

    <section class="post-cta">
      <p class="post-cta__status">
        <img src="/images/home/indicator.svg" width="6" height="6" alt="" />
        Asesorías disponibles
      </p>
      <h2 class="post-cta__title">¿Querés aplicar todo esto en tu proyecto?</h2>
      <p class="post-cta__text">Agendá una charla honesta de 30 minutos sin costo. Sin fórmulas mágicas: encontramos juntos dónde está la oportunidad real.</p>
      {/* Button text and duration pending: spec 12-blog-redesign, A CONFIRMAR #5 */}
      <a href={CALENDLY_URL} target="_blank" rel="noopener" class="pill-button pill-button--on-dark" data-track="cta_article_call">Agendá una llamada →</a>
    </section>
  </div>
</BaseLayout>
