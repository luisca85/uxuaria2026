---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArrowLink from '../../components/ArrowLink.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import { SERVICES } from '../../lib/services';
import { BOOKING_URL } from '../../lib/booking';

// Services hub (spec 17-servicios-hub): /servicios/ had Search Console impressions and redirected to /#servicios
const url = 'https://uxuaria.com/servicios/';

// Home symbols, one per service (spec 17)
const SYMBOLS = {
  diagnostico: { src: '/images/home/symbol-research.svg', modifier: '' },
  'design-system': { src: '/images/home/symbol-build.svg', modifier: 'route-card__symbol--half' },
  'ai-native': { src: '/images/home/symbol-design.svg', modifier: 'route-card__symbol--quarter' },
  rescue: { src: '/images/home/symbol-research.svg', modifier: 'route-card__symbol--half' },
} as const;
const diagnosisUrl = (cta: string) => `/diagnostico/?cta=${cta}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Servicios de diseño UX/UI de Uxuaria',
    itemListElement: SERVICES.map((service, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Service',
        name: service.name,
        description: service.summary,
        url: new URL(service.href, 'https://uxuaria.com').href,
        provider: { '@type': 'Organization', name: 'Uxuaria', url: 'https://uxuaria.com' },
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://uxuaria.com/' },
      { '@type': 'ListItem', position: 2, name: 'Servicios', item: url },
    ],
  },
];
---
<BaseLayout
  title="Servicios de diseño UX/UI para startups | Uxuaria"
  description="Diagnóstico UX, design systems AI ready, diseño de producto AI-native y rescate de MVP hecho con IA: servicios de diseño UX/UI para startups de fintech y SaaS."
  legacyStyles={false}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/service.css?v=20261111f" />
    <link rel="stylesheet" href="/services-hub.css?v=20261113" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="page-shell service-page">
    <section class="service-hero service-hero--wide">
      <div class="service-hero__inner page-container">
        <nav class="page-breadcrumb" aria-label="Ruta de navegación">
          <a href="/" class="page-breadcrumb__item">INICIO</a>
          <span class="page-breadcrumb__separator" aria-hidden="true">›</span>
          <span class="badge service-hero__badge" aria-current="page">Servicios</span>
        </nav>
        <h1 class="service-hero__title">Servicios de diseño UX/UI para startups</h1>
        <p class="service-hero__lead">Desde detectar qué frena a tus usuarios hasta convertir tu prototipo hecho con IA en un producto que escala. Elige por dónde empezar.</p>
        <div class="service-hero__actions">
          <a href={BOOKING_URL} target="_blank" rel="noopener" class="pill-button service-hero__cta" data-track="cta_servicios_hero">Agenda una llamada</a>
          <a href={diagnosisUrl('servicios_hero')} class="service-hero__link" data-track="cta_servicios_hero_diagnostico">
            Pide tu diagnóstico UX gratuito
            <img src="/images/home/chevron-forward.svg" width="24" height="24" alt="" />
          </a>
        </div>
      </div>
    </section>

    <section class="service-section page-container" aria-labelledby="recorrido-title">
      <div class="service-head">
        <p class="service-head__eyebrow">El recorrido</p>
        <h2 class="service-head__title" id="recorrido-title">¿Por dónde empieza tu producto?</h2>
      </div>
      <ol class="route">
        {SERVICES.map((service, index) => (
          <li class="route__step">
            <article class="route-card">
              <div class="route-card__top">
                <img class={`route-card__symbol ${SYMBOLS[service.id].modifier}`} src={SYMBOLS[service.id].src} width="65" height="66" alt="" />
                <span class="route-card__index">{String(index + 1).padStart(2, '0')}</span>
              </div>
              <h3 class="route-card__title">{service.name}</h3>
              <p class="route-card__text">{service.summary}</p>
              <ArrowLink label={service.link} href={service.href} align="start" track={`servicios_${service.id}`} />
            </article>
            {index < SERVICES.length - 1 && (
              <div class="route__link" aria-hidden="true">
                <span class="route__rail"></span>
                <span class="route__rail"></span>
              </div>
            )}
          </li>
        ))}
      </ol>
    </section>

    <ClosingCta
      title="Hablemos de tu producto."
      text="Agenda una llamada o pide el diagnóstico UX gratuito, sin compromiso."
      label="Agenda una llamada"
      track="cta_servicios_cierre"
      secondaryLabel="Pide tu diagnóstico UX gratuito"
      secondaryHref={diagnosisUrl('servicios_cierre')}
      secondaryTrack="cta_servicios_cierre_diagnostico"
    />
  </div>
</BaseLayout>
