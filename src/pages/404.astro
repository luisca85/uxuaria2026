---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SERVICES } from '../lib/services';

// Cloudflare Pages serves dist/404.html for any missing URL. Copy from the
// current 404.html, without voseo (decisions.md, 2026-11-03)
---
<BaseLayout
  title="Página no encontrada | Uxuaria"
  description="La página que buscas no existe o cambió de dirección. Vuelve al inicio o mira los servicios, los proyectos y el blog de Uxuaria."
  noindex
  webAnalytics={false}
  legacyStyles={false}
>
  <link slot="head" rel="stylesheet" href="/service.css?v=20261111f" />

  <div class="page-shell service-page">
    <section class="service-hero service-hero--wide">
      <div class="service-hero__inner page-container">
        <span class="badge service-hero__badge">404</span>
        <h1 class="service-hero__title">Esta página no existe o se mudó</h1>
        <p class="service-hero__lead">El enlace que seguiste está roto o la página cambió de dirección. Vuelve al inicio o mira nuestros servicios, proyectos y artículos.</p>
        <div class="service-hero__actions">
          <a href="/" class="pill-button service-hero__cta" data-track="cta_404_inicio">Ir al inicio</a>
          <a href="/blog" class="service-hero__link">
            Ir al blog
            <img src="/images/home/chevron-forward.svg" width="24" height="24" alt="" />
          </a>
        </div>
      </div>
    </section>

    <section class="service-section service-section--full" aria-labelledby="servicios-title">
      <div class="service-head page-container">
        <p class="service-head__eyebrow">Servicios</p>
        <h2 class="service-head__title" id="servicios-title">Quizás buscabas alguno de estos</h2>
      </div>
      <ul class="service-links">
        {[...SERVICES.map((s) => ({ label: s.link, href: s.href })), { label: 'Proyectos', href: '/portafolio' }].map((item) => (
          <li>
            <a href={item.href} class="service-link">
              <span class="service-link__label">{item.label}</span>
              <img class="service-link__arrow" src="/images/home/arrow-right.svg" width="48" height="48" alt="" />
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
