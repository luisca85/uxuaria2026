---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  legacyStyles?: boolean;
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  ogImage = '/images/og-uxuaria.jpg',
  ogType = 'website',
  noindex = false,
  // Pages not yet moved to the new design keep Retro 3.1 (spec 11-home)
  legacyStyles = true,
} = Astro.props;

// Clean URLs, no trailing .html (decisions.md 2026-07-02)
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, ''), Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Google Analytics (GA4) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-6TCJ5969G7" is:inline></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-6TCJ5969G7');
  </script>

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
  <meta name="author" content="Luis Carlos Romero León" />

  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content={ogType} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:locale" content="es_AR" />
  <meta property="og:site_name" content="Uxuaria" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImageUrl} />
  <slot name="head" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Share+Tech+Mono&family=Press+Start+2P&family=Space+Grotesk:wght@400;500;700&family=Space+Mono:wght@700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href={legacyStyles ? '/styles.css' : '/base.css?v=20261102'} />
  <link rel="stylesheet" href="/site.css?v=20261111b" />
</head>
<body>
  <Navbar />
  <main>
    <slot />
  </main>
  <Footer />
  <script src="/script.js" is:inline></script>
</body>
</html>
